# 本地密钥配置模板
# 复制为 .env 并填入真实值；.env 已 gitignore；shell 环境变量优先于本文件
# 演示模拟模式已移除：服务启动即要求四类能力的 *_API_KEY（fail-fast）；
# PB_PROVIDERS=fake 仅供 Playwright e2e 注入确定性桩，不面向真实使用。
#
# 统一格式：四类能力各自独立一组，前缀 TEXT / IMAGE / VIDEO / TTS
#   <前缀>_API        接口协议（见下方各能力可选值）
#   <前缀>_BASE_URL   端点地址
#   <前缀>_API_KEY    密钥（必填）
#   <前缀>_MODEL      模型名
# 四组互不影响，可分别指向不同厂商或 OpenAI 兼容网关。

PB_PROVIDERS=real

# --- 文本（故事文案 + 剧本分析）---
# TEXT_API=openai：走 OpenAI 兼容 POST {BASE_URL}/chat/completions（DeepSeek 官方或任意兼容网关）
TEXT_API=openai
TEXT_BASE_URL=https://api.deepseek.com
TEXT_API_KEY=
TEXT_MODEL=deepseek-chat

# --- 文生图 ---
# IMAGE_API=dashscope（百炼原生 multimodal-generation）| openai（OpenAI 兼容 /images/generations）
IMAGE_API=dashscope
IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
IMAGE_API_KEY=
IMAGE_MODEL=qwen-image-2.0

# --- AI 生视频（故事视频产线逐场 r2v 参考图生视频）---
# VIDEO_API=dashscope（百炼原生 video-synthesis + /tasks 轮询；r2v 需 wan2.7-r2v 系模型）
#           | newapi（OpenAI 兼容网关任务式：POST {base}/video/generations 提交、GET {base}/video/generations/{id} 轮询；
#                    仅支持 i2v 首帧形态，不兼容 r2v）
#           | openai（官方 /v1/videos：multipart 提交 + 轮询 + /content 下载，Sora 系列；不兼容 r2v）
VIDEO_API=dashscope
VIDEO_BASE_URL=https://dashscope.aliyuncs.com/api/v1
VIDEO_API_KEY=
VIDEO_MODEL=wan2.7-r2v-2026-06-12

# --- 旁白 TTS（制作视频阶段逐场/逐页自动合成）---
# TTS_API=dashscope（百炼 Qwen-TTS；instruct 系模型支持语速/情感指令控制）
# voice 只能用 Qwen-TTS 系列音色（Cherry/Serena/Ethan/Chelsie/Momo/Vivian/Moon/Maia 等），
# 见 https://help.aliyun.com/zh/model-studio/qwen-tts-voice-list
TTS_API=dashscope
TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
TTS_API_KEY=
TTS_MODEL=qwen3-tts-instruct-flash
TTS_VOICE=Cherry
TTS_INSTRUCTIONS=语速缓慢柔和，声音温柔治愈，像睡前电台在安抚听众，句尾轻轻收住。
